(footprint "CoaxFeed_Gap2mm"
	(version 20241229)
	(generator "layout.py")
	(layer "F.Cu")
	(descr "Solder pads for a 50 Ohm coax pigtail (RG316/RG174) across a 2 mm feed gap, pad 1 centre conductor, pad 2 shield, cable leaves to +y")
	(attr smd)
	(property "Reference" "REF**" (at 0 -3.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "Coax" (at 0 6 0) (layer "F.Fab") (hide yes) (effects (font (size 1 1) (thickness 0.15))))
	(pad "1" smd rect (at -2.250 0) (size 2.5 3.0) (layers "F.Cu" "F.Mask"))
	(pad "2" smd rect (at 2.250 0) (size 2.5 3.0) (layers "F.Cu" "F.Mask"))
	(fp_line (start -1.25 2.5) (end -1.25 8) (stroke (width 0.15) (type dash)) (layer "F.SilkS"))
	(fp_line (start 1.25 2.5) (end 1.25 8) (stroke (width 0.15) (type dash)) (layer "F.SilkS"))
	(fp_rect (start -3.750 -1.750) (end 3.750 2.5) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
)
